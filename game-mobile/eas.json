{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.13.0",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DROPITYCOON_RUNTIME_MODE": "remote"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "node": "22.13.0",
      "environment": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DROPITYCOON_RUNTIME_MODE": "remote"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.13.0",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DROPITYCOON_RUNTIME_MODE": "bundled"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
